# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate the secrets rather than inventing them:
#   openssl rand -base64 48   # for RECONPILOT_JWT_SECRET
#   openssl rand -base64 24   # for each password

DB_NAME=reconpilot
DB_OWNER_USER=reconpilot
DB_OWNER_PASSWORD=

# The least-privilege runtime role. Created by migration V6, which runs as the
# owner above. Row-level security applies to this role and not to the owner, so
# these must stay two different accounts.
DB_APP_USER=reconpilot_app
DB_APP_PASSWORD=

# At least 32 bytes. This is the whole of authentication: anyone holding it can
# mint a valid token for any user of any tenant.
RECONPILOT_JWT_SECRET=

# Which ports the app is served on. HTTP only redirects to HTTPS.
HTTP_PORT=8081
HTTPS_PORT=8443

# --- TLS ---------------------------------------------------------------------
# selfsigned  generate a certificate on first start. Browsers will warn, and
#             they are right to: nothing vouches for it. Fine for a laptop.
# provided    use a real certificate bind-mounted read-only at /etc/nginx/tls
#             as fullchain.pem and privkey.pem. Turns HSTS on.
# off         serve plain HTTP, for when a load balancer or ingress in front
#             already terminates TLS. Only safe if that is actually true.
TLS_MODE=selfsigned
TLS_SERVER_NAME=localhost

# --- Backups -----------------------------------------------------------------
# The backup container dumps the database on this interval and keeps the newest
# BACKUP_KEEP copies. Verify them with the restore drill; a backup nobody has
# restored is a hypothesis:
#   docker compose -f docker-compose.prod.yml \
#       run --rm --entrypoint /ops/restore-drill.sh backup
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7

# Leave false until the MDR rounding rule is confirmed (defect D7). A one-paise
# disagreement produced 8,174 false claims in testing.
CLAIMS_FILING_ENABLED=false

# AI format discovery. Needs a key, and sends sample settlement rows to an
# external service -- see defect D15 before enabling on real customer data.
AI_FORMAT_DISCOVERY_ENABLED=false
ANTHROPIC_API_KEY=
